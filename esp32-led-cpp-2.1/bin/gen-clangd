#!/usr/bin/env bash
#
# Regenerate a SELF-CONTAINED .clangd for this PlatformIO / ESP32-S3 project.
#
# Why: the build uses xtensa-esp32s3-elf-g++ (GCC) but the editor LSP is
# Apple/LLVM clangd. This bakes the xtensa target + the toolchain's own system
# include paths into .clangd (queried live from the compiler) and strips the
# GCC-only flags clang rejects. The result works everywhere with no extra args,
# including a bare `clangd --check`.
#
# Re-run this whenever the ESP32 toolchain is installed or updated:
#     ./tools/gen-clangd.sh
#
set -euo pipefail

# Run from repo root regardless of where the script is invoked from.
cd "$(dirname "$0")/.."

# 1. Locate the xtensa build compiler.
GXX="$(command -v xtensa-esp32s3-elf-g++ 2>/dev/null || true)"
[ -n "$GXX" ] || GXX="$HOME/.platformio/packages/toolchain-xtensa-esp32s3/bin/xtensa-esp32s3-elf-g++"
[ -x "$GXX" ] || { echo "error: xtensa g++ not found (looked for: $GXX)" >&2; exit 1; }

# 2. Ask the compiler for its target triple and system header search paths.
TARGET="$("$GXX" -dumpmachine)"
SYS="$("$GXX" -E -x c++ -v /dev/null 2>&1 \
  | awk '/#include <...> search starts here:/{f=1;next} /End of search list/{f=0} f{print $1}' \
  | while read -r d; do python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$d"; done)"

# 3. Emit .clangd
{
  echo "# AUTO-GENERATED by tools/gen-clangd.sh — do not edit by hand."
  echo "# Bridges Apple/LLVM clangd to the xtensa-gcc build. Re-run the script"
  echo "# after installing/updating the ESP32 toolchain to refresh the paths below."
  echo "CompileFlags:"
  echo "  Compiler: xtensa-esp32s3-elf-g++"
  echo "  Add:"
  echo "    - --target=$TARGET"
  while read -r d; do [ -n "$d" ] && echo "    - -isystem$d"; done <<< "$SYS"
  echo "  Remove:"
  echo "    - -m*                            # -mlongcalls, -mtext-section-literals, ..."
  echo "    - -fno-tree-switch-conversion"
  echo "    - -fstrict-volatile-bitfields"
  echo "    - -freorder-blocks"
  echo "    - -fno-jump-tables"
} > .clangd

echo "Wrote .clangd  (target=$TARGET, $(printf '%s\n' "$SYS" | grep -c .) system include dirs)"

