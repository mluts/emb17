CompileFlags:
  Compiler: /Users/michael/.platformio/packages/toolchain-xtensa-esp-elf/bin/xtensa-esp32s3-elf-g++
  Remove:
    - -m*
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-malloc-dce
    - -fzero-init-padding-bits=*
    - -Wno-old-style-declaration
    - -freorder-blocks
    - -fno-stack-protector
    # - -specs=*
    - -fmacro-prefix-map=*
