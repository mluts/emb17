# NOTE: clangd parses the arm-none-eabi-g++ commands from compile_commands.json
# with clang, which identifies itself as GCC 4.2.1. Arduino.h computes
# GCC_VERSION from __GNUC__* and #errors below 6.3. Report the real toolchain
# version (arm-none-eabi-g++ -dumpfullversion == 12.3.1) instead.
CompileFlags:
  Add:
    - -fgnuc-version=12.3.1
